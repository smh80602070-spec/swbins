static func tip(id: String) -> String:
	return String((TIPS.get(id, ["", ""]) as Array)[0])


static func seen(id: String) -> bool:
	return (PartyState.tips as Array).has(id)


static func mark(id: String) -> void:
	if not (PartyState.tips as Array).has(id):
		(PartyState.tips as Array).append(id)
