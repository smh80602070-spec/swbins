const END_WIN := ["「이겼다! 다들 잘 버텼다.」", "「한 고비 넘겼군. 다음 장으로 가자.」", "「이 땅은 지켜 냈다. 숨 돌리고 다시 나아간다.」", "「적장의 깃발이 꺾였다 — 우리 차례다.」"]
const END_LOSE := ["「물러난다… 다음엔 반드시 되갚는다.」", "「진영으로 돌아가 다시 짠다. 편성을 바꿔 보자.」", "「상성을 잘못 읽었다… 다시 겨룬다.」"]
const END_SPECIAL := {
	"r6_end": {"win":"「천하의 끝… 함께 온 모두의 이름으로 맺는다.」"},
	"r3_river": {"win":"「바람이 우리 편이었다. 강은 이제 조용하다.」"},
	"r4_rift": {"win":"「문이 닫혔다. 세 시대의 성벽이 버텼다!」"}
