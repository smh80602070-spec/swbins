static func of(chapter_id: String) -> Dictionary:
	var script: Variant = SCRIPTS.get(chapter_id, {})
	return (script as Dictionary).duplicate(true) if script is Dictionary else {}

static func _hash_s(value: String) -> int:
	var h := 2166136261
	for i in value.length():
		h = (h ^ value.unicode_at(i)) & 0xffffffff
		h = (h * 16777619) & 0xffffffff
	return h

static func end_line(chapter_id: String, won: bool) -> String:
	var key := "win" if won else "lose"
	var special: Dictionary = END_SPECIAL.get(chapter_id, {})
	if special.has(key): return String(special[key])
	var lines: Array = END_WIN if won else END_LOSE
	var salt := chapter_id + ("w" if won else "l")
	return String(lines[_hash_s(salt) % lines.size()])
