; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SAGA"
run/main_scene="res://games/saga_go/world/TestVillage.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

CombatFeel="*res://saga_core/combat_feel.gd"
PartyState="*res://games/saga_go/data/party_state.gd"
SaveState="*res://games/saga_go/data/save_state.gd"
QuestState="*res://games/saga_go/data/quest_state.gd"
EventState="*res://games/saga_go/data/event_state.gd"
CodexState="*res://games/saga_go/data/codex_state.gd"
DropState="*res://games/saga_go/data/drop_state.gd"
DungeonSaveState="*res://games/saga_dungeon/data/dungeon_save_state.gd"
DungeonRunState="*res://games/saga_dungeon/data/dungeon_run_state.gd"
DungeonEquipmentState="*res://games/saga_dungeon/data/dungeon_equipment_state.gd"
DungeonMaterialsState="*res://games/saga_dungeon/data/dungeon_materials_state.gd"
DungeonGoldState="*res://games/saga_dungeon/data/dungeon_gold_state.gd"
DungeonPotionState="*res://games/saga_dungeon/data/dungeon_potion_state.gd"
DungeonPartyState="*res://games/saga_dungeon/data/dungeon_party_state.gd"
DungeonHardcoreState="*res://games/saga_dungeon/data/dungeon_hardcore_state.gd"
DungeonGraveState="*res://games/saga_dungeon/data/dungeon_grave_state.gd"
DungeonSkillState="*res://games/saga_dungeon/data/dungeon_skill_state.gd"
DungeonSigilState="*res://games/saga_dungeon/data/dungeon_sigil_state.gd"
DungeonHordeState="*res://games/saga_dungeon/data/dungeon_horde_state.gd"
DungeonWorldBossState="*res://games/saga_dungeon/data/dungeon_worldboss_state.gd"
ForestSaveState="*res://games/saga_forest/data/forest_save_state.gd"
StorySaveState="*res://games/saga_story/data/story_save_state.gd"
StoryLabyrinthState="*res://games/saga_story/data/story_labyrinth_state.gd"
RealmSaveState="*res://games/saga_realm/data/realm_save_state.gd"

[debug]

file_logging/enable_file_logging.mobile=true

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="sensor"

[importer_defaults]

texture={
"compress/mode": 2,
"mipmaps/generate": true
}

