    { "key": "landmark.dark_forest.lore", "value": "No one knows who stacked this altar. They say its lanterns have never gone out." },
    { "key": "landmark.rocky", "value": "Giant's Standing Stone" },
    { "key": "landmark.rocky.lore", "value": "Said to be a staff a giant left stuck in the earth. Knock on it and it hums low." },
    { "key": "landmark.mushroom_forest", "value": "Fairy Stone Ring" },
