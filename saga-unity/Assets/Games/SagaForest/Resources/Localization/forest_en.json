    { "key": "biome.dark_forest.lore", "value": "A forest the sun never reaches. Forest goblins and mist ghosts circle the mossy altar." },
    { "key": "biome.rocky.lore", "value": "Dry ochre ground where great boulders rise. Rock goblins and iron goblins roll stones for fun." },
    { "key": "biome.mushroom_forest.lore", "value": "A damp violet wood. Mushroom spirits live here, and spore beasts block the path." },
    { "key": "biome.flower_field.lore", "value": "A warm spring-green meadow. Flower spirits and butterfly spirits flit between old stone pillars." },
