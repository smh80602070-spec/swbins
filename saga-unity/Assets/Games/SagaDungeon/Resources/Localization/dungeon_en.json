    { "key": "era_folk.courier", "value": "Courier" },
    { "key": "era_folk.courier.0", "value": "The address just says 'third village, during the Yellow Turban riots'. This is it, right?" },
    { "key": "era_folk.courier.1", "value": "The parcel keeps getting heavier. Something inside sounds like a blade being sharpened." },
    { "key": "era_folk.courier.2", "value": "No deliveries to the lower floors. Last time a steel doll signed with its fist." },
    { "key": "era_folk.courier.3", "value": "They say there's a time-rift surcharge. Anyone want to pay it?" },
    { "key": "era_folk.chrononaut", "value": "Time Traveler" },
    { "key": "era_folk.chrononaut.0", "value": "The records say this village vanishes in these riots. I hope I'm wrong." },
    { "key": "era_folk.chrononaut.1", "value": "The deeper the floor, the wider the rift. Machines from my era got lost down there." },
    { "key": "era_folk.chrononaut.2", "value": "That blade looks exactly like one hanging in a museum in my time." },
    { "key": "era_folk.chrononaut.3", "value": "My way back has closed. I'll be eating this era's food for a while." },
    { "key": "era_folk.surveyor", "value": "Surveyor" },
    { "key": "era_folk.surveyor.0", "value": "Measuring underground resonance. The readings swing wildly the deeper you go." },
    { "key": "era_folk.surveyor.1", "value": "If you meet a sentry walker, aim for the knee joints. Straight from our field manual." },
    { "key": "era_folk.surveyor.2", "value": "People of this era are tough. Climbing ruins without protective suits." },
    { "key": "era_folk.surveyor.3", "value": "Bring me one sample. A floor lord's scale would be even better." },
    { "key": "era_folk.salaryman", "value": "Office Worker on a Business Trip" },
    { "key": "era_folk.salaryman.0", "value": "I only dozed off on the subway, and I woke up at this crossroads." },
    { "key": "era_folk.salaryman.1", "value": "My report is due tomorrow... is there anywhere with electricity here?" },
    { "key": "era_folk.salaryman.2", "value": "Those people in gas masks look like our company's disinfection team, but they won't talk to me." },
    { "key": "era_folk.salaryman.3", "value": "Shall I give you my card? Ah, paper is precious in this era, you say." },
