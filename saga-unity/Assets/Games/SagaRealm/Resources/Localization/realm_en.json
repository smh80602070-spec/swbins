    { "key": "quiz.p01.q", "value": "What does the proverb \"a word without feet travels a thousand ri\" refer to?" },
    { "key": "quiz.p01.c0", "value": "Rumors spread quickly" },
    { "key": "quiz.p01.c1", "value": "A horse that runs well" },
    { "key": "quiz.p01.c2", "value": "A person who walks fast" },
    { "key": "quiz.p01.c3", "value": "A letter that travels far" },
    { "key": "quiz.p01.why", "value": "Here \"mal\" means \"word/speech\" (not \"horse\") — a warning to watch what you say." },
    { "key": "quiz.p02.q", "value": "What does the proverb \"it's dark under the lamp\" mean?" },
    { "key": "quiz.p02.c0", "value": "You often overlook what's right in front of you" },
    { "key": "quiz.p02.c1", "value": "The flame is weak" },
    { "key": "quiz.p02.c2", "value": "Nights are dangerous" },
    { "key": "quiz.p02.c3", "value": "Subordinates have it hard" },
    { "key": "quiz.p02.why", "value": "It means you may know others' affairs well but miss what's happening right around you." },
    { "key": "quiz.p04.q", "value": "Who does the proverb \"a frog in a well\" refer to?" },
    { "key": "quiz.p04.c0", "value": "Someone who knows only their small world and not the wider one" },
    { "key": "quiz.p04.c1", "value": "Someone who loves water" },
    { "key": "quiz.p04.c2", "value": "A timid person" },
    { "key": "quiz.p04.c3", "value": "A good swimmer" },
    { "key": "quiz.p04.why", "value": "It criticizes a narrow view that mistakes one's limited knowledge for the whole world." },
    { "key": "quiz.p05.q", "value": "What does the proverb \"mending the barn after losing the ox\" mean?" },
    { "key": "quiz.p05.c0", "value": "Preparing only after disaster has already struck" },
    { "key": "quiz.p05.c1", "value": "Oxen are important" },
    { "key": "quiz.p05.c2", "value": "Houses need frequent repair" },
    { "key": "quiz.p05.c3", "value": "Losses can always be recovered" },
    { "key": "quiz.p05.why", "value": "It means failing to prepare in advance and regretting it too late." },
    { "key": "quiz.p06.q", "value": "What does the proverb \"even a sheet of paper is lighter when lifted together\" mean?" },
    { "key": "quiz.p06.c0", "value": "Even easy tasks go more smoothly with help" },
    { "key": "quiz.p06.c1", "value": "Paper is light" },
    { "key": "quiz.p06.c2", "value": "Working alone is faster" },
    { "key": "quiz.p06.c3", "value": "Small tasks can be postponed" },
    { "key": "quiz.p06.why", "value": "Even the lightest task is easier with combined effort — it praises the value of cooperation." },
    { "key": "quiz.p11.q", "value": "What does the proverb \"can you tie thread to the middle of a needle and use it?\" mean?" },
    { "key": "quiz.p11.c0", "value": "You can't skip the proper steps" },
    { "key": "quiz.p11.c1", "value": "Needles are dangerous" },
    { "key": "quiz.p11.c2", "value": "Thread must be thick" },
    { "key": "quiz.p11.c3", "value": "Sewing is difficult" },
    { "key": "quiz.p11.why", "value": "It means you must follow proper procedure even when in a hurry — thread must go through the needle's eye." },
