    { "key": "region.village.lore", "value": "The first fields, where the waypoint and market gather. No blade is drawn inside the village fence." },
    { "key": "region.west_wood.lore", "value": "A dark trail lined with lightning-struck trees. Storm wraiths leap between the trunks." },
    { "key": "region.east_grove.lore", "value": "A bandit den hides in the amber autumn grove. Old battlefield skeletons and pond ghosts stir as well." },
    { "key": "region.north_foot.lore", "value": "A cold slope strewn with graves of a fallen fort. Skeleton soldiers stand guard in rows." },
    { "key": "region.river.lore", "value": "The stream that divides the village from the south. Mind your stamina when you swim." },
    { "key": "region.south_glade.lore", "value": "A golden meadow at the foot of the old watchtower. Its guardian still stands." },
    { "key": "region.farmland.lore", "value": "Will-o'-wisps flare on the dry paddy banks. Bandits eye the harvest." },
