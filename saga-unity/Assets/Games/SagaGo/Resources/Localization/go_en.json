    { "key": "folk.woodcutter", "value": "Woodcutter" },
    { "key": "folk.woodcutter.line", "value": "The wood of {0} has a fine grain. I chop every log around {1}. Lately folk in iron clothes keep coming to watch." },
    { "key": "folk.shrine_maiden", "value": "Shrine Maiden" },
    { "key": "folk.shrine_maiden.line", "value": "A strange air mixes into the wind of {0}. They say a rift opened in the sky and people from other times are crossing over." },
    { "key": "folk.watchman", "value": "Watchman" },
    { "key": "folk.watchman.line", "value": "Guarding {1} is my job. So many oddly dressed visitors these days, I can't tell who the bandits are." },
    { "key": "folk.hunter", "value": "Hunter" },
    { "key": "folk.hunter.line", "value": "Iron wheel tracks among the beast prints of {0}. Never seen marks like that in my life." },
    { "key": "folk.tourist", "value": "Tourist" },
    { "key": "folk.tourist.line", "value": "My map app doesn't show anywhere like {0}... but the view is amazing." },
    { "key": "folk.courier", "value": "Courier" },
    { "key": "folk.courier.line", "value": "I have a parcel for {1}, but the recipient lived three hundred years ago. How do I get a signature?" },
    { "key": "folk.patrol", "value": "Patrol Officer" },
    { "key": "folk.patrol.line", "value": "A gang in gas masks is roaming around {0}. Don't travel alone." },
    { "key": "folk.surveyor", "value": "Surveyor" },
    { "key": "folk.surveyor.line", "value": "Sampling the air of {0}. The time rift is open widest around here." },
    { "key": "folk.mechanic", "value": "Mechanic" },
    { "key": "folk.mechanic.line", "value": "That stone pillar at {1} — stone outside, but inside it hums like a relay from my era." },
    { "key": "folk.chrononaut", "value": "Time Traveler" },
    { "key": "folk.chrononaut.line", "value": "{0}... I've only seen this place in records. Please keep it secret that I was here." },
    { "key": "hero.sg_guanyu", "value": "Myeongun" },
    { "key": "hero.sg_guanyu.quote", "value": "With one who knows righteousness, I will go anywhere." },
    { "key": "hero.sg_zhangfei", "value": "Noeho" },
    { "key": "hero.sg_zhangfei.quote", "value": "Let's talk it over with a drink!" },
    { "key": "hero.sg_zhaoyun", "value": "Eunchang" },
    { "key": "hero.sg_zhaoyun.quote", "value": "I will guard my lord with my life." },
    { "key": "hero.sg_zhugeliang", "value": "Hyeonchaek" },
    { "key": "hero.sg_zhugeliang.quote", "value": "I will not forget the meaning of those three visits." },
    { "key": "hero.sg_liubei", "value": "Inhyeong" },
    { "key": "hero.sg_liubei.quote", "value": "We share the same heart for the people." },
    { "key": "hero.sg_machao", "value": "Seopung" },
    { "key": "hero.sg_machao.quote", "value": "I will lend you the spear of the western frontier." },
    { "key": "hero.sg_huangzhong", "value": "Nogung" },
    { "key": "hero.sg_huangzhong.quote", "value": "Don't look down on me for being old!" },
    { "key": "hero.sg_caocao", "value": "Paeheon" },
    { "key": "hero.sg_caocao.quote", "value": "I would rather betray the world than let the world betray me." },
    { "key": "hero.sg_simayi", "value": "Eunin" },
    { "key": "hero.sg_simayi.quote", "value": "The one who knows how to wait is the one who wins." },
    { "key": "hero.sg_xiahoudun", "value": "Eonmu" },
    { "key": "hero.sg_xiahoudun.quote", "value": "Even with one eye, I see the enemy well enough." },
    { "key": "hero.sg_zhangliao", "value": "Cheolbyeok" },
    { "key": "hero.sg_zhangliao.quote", "value": "I will hold off a hundred thousand with eight hundred." },
    { "key": "hero.sg_xunyu", "value": "Cheongan" },
    { "key": "hero.sg_xunyu.quote", "value": "You call me a king's right hand — I am honored and ashamed." },
    { "key": "hero.sg_sunquan", "value": "Byeokhae" },
    { "key": "hero.sg_sunquan.quote", "value": "The east of the river welcomes those who know how to join hands." },
    { "key": "hero.sg_zhouyu", "value": "Hwapung" },
    { "key": "hero.sg_zhouyu.quote", "value": "When the southeast wind blows, our time has come." },
    { "key": "hero.sg_luxun", "value": "Damyeon" },
    { "key": "hero.sg_luxun.quote", "value": "Not hurrying is my art of war." },
    { "key": "hero.sg_taishici", "value": "Gungseong" },
    { "key": "hero.sg_taishici.quote", "value": "Let me show you my archery." },
    { "key": "hero.sg_ganning", "value": "Yeongjin" },
    { "key": "hero.sg_ganning.quote", "value": "When you hear the bells, it is already too late." },
    { "key": "hero.sg_lubu", "value": "Paechang" },
    { "key": "hero.sg_lubu.quote", "value": "Unrivaled under heaven! Who dares to stop me?" },
    { "key": "hero.sg_diaochan", "value": "Wolyeong" },
    { "key": "hero.sg_diaochan.quote", "value": "If I can be of help, then so be it." },
    { "key": "hero.sg_pangtong", "value": "Bongrae" },
    { "key": "hero.sg_pangtong.quote", "value": "Bongrae is here." },
    { "key": "hero.sg_huatuo", "value": "Sinchim" },
    { "key": "hero.sg_huatuo.quote", "value": "If it saves lives, I will join you." },
    { "key": "hero.sg_menghuo", "value": "Manwang" },
    { "key": "hero.sg_menghuo.quote", "value": "Beaten seven times, I rise an eighth!" },
    { "key": "hero.kr_yisunsin", "value": "Haejang" },
    { "key": "hero.kr_yisunsin.quote", "value": "Your servant still has twelve ships left." },
    { "key": "hero.kr_euljimundeok", "value": "Hyeonmyo" },
    { "key": "hero.kr_euljimundeok.quote", "value": "Know contentment, and I advise you to stop here." },
    { "key": "hero.kr_ganggamchan", "value": "Gangu" },
    { "key": "hero.kr_ganggamchan.quote", "value": "Everything is ready to break the river dam." },
    { "key": "hero.kr_kimyusin", "value": "Hwarangjun" },
    { "key": "hero.kr_kimyusin.quote", "value": "I will join the three kingdoms into one." },
    { "key": "hero.kr_gyebaek", "value": "Gyeolsa" },
    { "key": "hero.kr_gyebaek.quote", "value": "With five thousand I will face fifty thousand." },
    { "key": "hero.kr_yeongaesomun", "value": "Cheolryeong" },
    { "key": "hero.kr_yeongaesomun.quote", "value": "The walls of Liaodong will not fall." },
    { "key": "hero.kr_gwanggaeto", "value": "Jeongbokwang" },
    { "key": "hero.kr_gwanggaeto.quote", "value": "North — ever further north!" },
    { "key": "hero.kr_sejong", "value": "Hunmin" },
    { "key": "hero.kr_sejong.quote", "value": "So that the people may learn it easily and use it every day." },
    { "key": "hero.kr_jangyeongsil", "value": "Seongsi" },
    { "key": "hero.kr_jangyeongsil.quote", "value": "I will show you how to measure time by the sun's shadow." },
    { "key": "hero.kr_choemuseon", "value": "Hwapogong" },
    { "key": "hero.kr_choemuseon.quote", "value": "Leave the gunpowder to me." },
    { "key": "hero.kr_daejoyeong", "value": "Yodongpae" },
    { "key": "hero.kr_daejoyeong.quote", "value": "I will carry on after Goguryeo." },
    { "key": "hero.kr_wanggeon", "value": "Tonghapgong" },
    { "key": "hero.kr_wanggeon.quote", "value": "My work is gathering again what was scattered." },
    { "key": "hero.kr_jeongyakyong", "value": "Mangi" },
    { "key": "hero.kr_jeongyakyong.quote", "value": "I will lighten the people's burdens with a crane." },
    { "key": "hero.kr_heojun", "value": "Hwalin" },
    { "key": "hero.kr_heojun.quote", "value": "Before illness, what does rank matter?" },
    { "key": "hero.kr_sinsaimdang", "value": "Chochungdang" },
    { "key": "hero.kr_sinsaimdang.quote", "value": "I only put my heart into the tip of the brush." },
    { "key": "hero.kr_ahnjunggeun", "value": "Dongyangpyeong" },
    { "key": "hero.kr_ahnjunggeun.quote", "value": "A day without reading makes thorns grow in my mouth." },
    { "key": "hero.kr_yugwansun", "value": "Sonyeohwa" },
    { "key": "hero.kr_yugwansun.quote", "value": "My only sorrow is having but one life to give to my country." },
    { "key": "hero.kr_kimgu", "value": "Jagang" },
    { "key": "hero.kr_kimgu.quote", "value": "My only wish is complete independence." },
    { "key": "hero.kr_wonhyo", "value": "Gakwon" },
    { "key": "hero.kr_wonhyo.quote", "value": "All things are made by the mind." },
    { "key": "hero.kr_kimjeongho", "value": "Banggak" },
    { "key": "hero.kr_kimjeongho.quote", "value": "I will fit this whole land onto a single sheet." },
    { "key": "hero.kr_gwakjaeu", "value": "Chomoui" },
    { "key": "hero.kr_gwakjaeu.quote", "value": "They say the invaders flee when they see the red robe." },
    { "key": "hero.kr_nongae", "value": "Hwayeong" },
    { "key": "hero.kr_nongae.quote", "value": "Please remember the waves of the South River." },
    { "key": "hero.kr_yihwang", "value": "Gyeongheon" },
    { "key": "hero.kr_yihwang.quote", "value": "I set my mind right through reverence." },
    { "key": "hero.kr_yii", "value": "Munhyeong" },
    { "key": "hero.kr_yii.quote", "value": "I hope the call for a hundred thousand soldiers was not too late." },
    { "key": "hero.kr_hwanghui", "value": "Gyunhyeonggong" },
    { "key": "hero.kr_hwanghui.quote", "value": "You are right, and you are right too." },
    { "key": "hero.kr_jeongmongju", "value": "Cheongjuk" },
    { "key": "hero.kr_jeongmongju.quote", "value": "Though I die a hundred times over, my heart stays the same." },
    { "key": "hero.jp_himiko", "value": "Yeowangyeong" },
    { "key": "hero.jp_himiko.quote", "value": "I rule the people's hearts with the way of spirits." },
    { "key": "hero.jp_taira", "value": "Pyeonggaju" },
    { "key": "hero.jp_taira.quote", "value": "If you are not of the Heike, you are not a person." },
    { "key": "hero.jp_yoritomo", "value": "Makbujo" },
    { "key": "hero.jp_yoritomo.quote", "value": "I will open an age of warriors." },
    { "key": "hero.jp_yoshitsune", "value": "Bijanggun" },
    { "key": "hero.jp_yoshitsune.quote", "value": "Even in my brother's shadow, my arrows never missed." },
    { "key": "hero.jp_murasaki", "value": "Wonssipil" },
    { "key": "hero.jp_murasaki.quote", "value": "A fleeting world — I will leave it as a tale." },
    { "key": "hero.jp_seishonagon", "value": "Chimchopil" },
    { "key": "hero.jp_seishonagon.quote", "value": "In spring, dawn is the loveliest." },
    { "key": "hero.jp_tomoegozen", "value": "Yeomuyeon" },
    { "key": "hero.jp_tomoegozen.quote", "value": "Being a woman is no reason I cannot draw a bow." },
    { "key": "hero.jp_nobunaga", "value": "Hwacheonma" },
    { "key": "hero.jp_nobunaga.quote", "value": "A bird that will not sing gets cut down." },
    { "key": "hero.jp_hideyoshi", "value": "Taehapwon" },
    { "key": "hero.jp_hideyoshi.quote", "value": "Heaven can be seized with talent, too." },
    { "key": "hero.jp_ieyasu", "value": "Innaeong" },
    { "key": "hero.jp_ieyasu.quote", "value": "Just wait until the cuckoo sings." },
    { "key": "hero.jp_shingen", "value": "Pungrimhwa" },
    { "key": "hero.jp_shingen.quote", "value": "Swift as the wind, quiet as the forest." },
    { "key": "hero.jp_kenshin", "value": "Gunsina" },
    { "key": "hero.jp_kenshin.quote", "value": "I see no reason not to send salt to my enemy." },
    { "key": "hero.jp_masamune", "value": "Dokanryong" },
    { "key": "hero.jp_masamune.quote", "value": "Even with one eye, I can see all under heaven." },
    { "key": "hero.jp_yukimura", "value": "Ilbeonchang" },
    { "key": "hero.jp_yukimura.quote", "value": "The last spear of Osaka will be mine to hold." },
    { "key": "hero.jp_musashi", "value": "Idoin" },
    { "key": "hero.jp_musashi.quote", "value": "A thousand days of practice, ten thousand days of training." },
    { "key": "hero.jp_hanzo", "value": "Amyeongjo" },
    { "key": "hero.jp_hanzo.quote", "value": "A shadow leaves no sound behind." },
    { "key": "hero.jp_mitsukuni", "value": "Cheonhabu" },
    { "key": "hero.jp_mitsukuni.quote", "value": "I will compile the history of this land." },
    { "key": "hero.jp_naosuke", "value": "Gaehangro" },
    { "key": "hero.jp_naosuke.quote", "value": "Opening the gates is also a way to defend the country." },
    { "key": "hero.jp_saigo", "value": "Choehuhyang" },
    { "key": "hero.jp_saigo.quote", "value": "Revere heaven and love people." },
    { "key": "hero.jp_ryoma", "value": "Haewonrang" },
    { "key": "hero.jp_ryoma.quote", "value": "The world must be washed clean again." },
    { "key": "hero.eu_caesar", "value": "Valerian" },
    { "key": "hero.eu_caesar.quote", "value": "I came, I saw, and now I will go with you." },
    { "key": "hero.eu_alexander", "value": "Cassiander" },
    { "key": "hero.eu_alexander.quote", "value": "Don't you want to see the end of the world?" },
    { "key": "hero.eu_hannibal", "value": "Magnaro" },
    { "key": "hero.eu_hannibal.quote", "value": "If there is no road, cross the Alps and make one." },
    { "key": "hero.eu_charlemagne", "value": "Lotharian" },
    { "key": "hero.eu_charlemagne.quote", "value": "I mean to build a realm that holds both sword and letters." },
    { "key": "hero.eu_joan", "value": "Selene" },
    { "key": "hero.eu_joan.quote", "value": "Fear is not mine to keep. Raise the banner." },
    { "key": "hero.eu_napoleon", "value": "Valdenar" },
    { "key": "hero.eu_napoleon.quote", "value": "'Impossible' is a coward's excuse." },
    { "key": "hero.eu_davinci", "value": "Marano" },
    { "key": "hero.eu_davinci.quote", "value": "There is so much I have yet to paint." },
    { "key": "hero.eu_augustus", "value": "Serenus" },
    { "key": "hero.eu_augustus.quote", "value": "I will turn a city of brick into one of marble." },
    { "key": "hero.eu_scipio", "value": "Corvinal" },
    { "key": "hero.eu_scipio.quote", "value": "I learned how to beat Magnaro from Magnaro himself." },
    { "key": "hero.eu_leonidas", "value": "Thessalor" },
    { "key": "hero.eu_leonidas.quote", "value": "Come and take it." },
    { "key": "hero.eu_aurelius", "value": "Berendel" },
    { "key": "hero.eu_aurelius.quote", "value": "Do not put off the good you can do today." },
    { "key": "hero.eu_richard", "value": "Codwin" },
    { "key": "hero.eu_richard.quote", "value": "A lion's heart knows no retreat." },
    { "key": "hero.eu_william", "value": "Pendrick" },
    { "key": "hero.eu_william.quote", "value": "Once you cross the sea, you burn the ships." },
    { "key": "hero.eu_harald", "value": "Ostvard" },
    { "key": "hero.eu_harald.quote", "value": "I came from the north. Can you row?" },
    { "key": "hero.eu_frederick", "value": "Vasilorn" },
    { "key": "hero.eu_frederick.quote", "value": "A king is the first servant of the state." },
    { "key": "hero.eu_peter", "value": "Volkanov" },
    { "key": "hero.eu_peter.quote", "value": "We must open a window to the sea." },
    { "key": "hero.eu_elizabeth", "value": "Corinelle" },
    { "key": "hero.eu_elizabeth.quote", "value": "I am married to this country." },
    { "key": "hero.eu_nelson", "value": "Ashgrave" },
    { "key": "hero.eu_nelson.quote", "value": "The nation expects each to do their duty." },
    { "key": "hero.eu_machiavelli", "value": "Vantorelli" },
    { "key": "hero.eu_machiavelli.quote", "value": "If you cannot be loved, at least do not be scorned." },
    { "key": "hero.eu_newton", "value": "Halverin" },
    { "key": "hero.eu_newton.quote", "value": "I merely stood on the shoulders of giants." },
    { "key": "hero.eu_michelangelo", "value": "Chellorini" },
    { "key": "hero.eu_michelangelo.quote", "value": "I only free what is already inside the stone." },
    { "key": "hero.eu_eleanor", "value": "Baelin" },
    { "key": "hero.eu_eleanor.quote", "value": "I was queen of two kingdoms — let me do the counting." },
    { "key": "hero.wd_ashoka", "value": "Beopryunwang" },
    { "key": "hero.wd_ashoka.quote", "value": "Land won by the sword I will now rule by the law." },
    { "key": "hero.wd_akbar", "value": "Gwanyongje" },
    { "key": "hero.wd_akbar.quote", "value": "Faith is not won by force." },
    { "key": "hero.wd_saladin", "value": "Uigeomju" },
    { "key": "hero.wd_saladin.quote", "value": "The gates of Jerusalem open to mercy as well." },
    { "key": "hero.wd_suleiman", "value": "Jangryeoje" },
    { "key": "hero.wd_suleiman.quote", "value": "I will build law and glory together." },
    { "key": "hero.wd_ibnsina", "value": "Uicheolin" },
    { "key": "hero.wd_ibnsina.quote", "value": "I will put the workings of the body into a single book." },
    { "key": "hero.wd_genghis", "value": "Chowonpae" },
    { "key": "hero.wd_genghis.quote", "value": "I will ride to the end of the world." },
    { "key": "hero.wd_khubilai", "value": "Daewonjo" },
    { "key": "hero.wd_khubilai.quote", "value": "I will join the steppe and the heartland into one." },
    { "key": "hero.wd_mansamusa", "value": "Hwanggeumwang" },
    { "key": "hero.wd_mansamusa.quote", "value": "The more gold is shared, the more it is mine." },
    { "key": "hero.wd_shaka", "value": "Changgunwang" },
    { "key": "hero.wd_shaka.quote", "value": "The short spear beats the long spear." },
    { "key": "hero.wd_cleopatra", "value": "Nailhwa" },
    { "key": "hero.wd_cleopatra.quote", "value": "The Nile is still on my side." },
    { "key": "hero.wd_pachacuti", "value": "Taeyanggae" },
    { "key": "hero.wd_pachacuti.quote", "value": "The one who overturns the world — that is my name." },
    { "key": "hero.wd_moctezuma", "value": "Doksuriju" },
    { "key": "hero.wd_moctezuma.quote", "value": "The stars foretold the arrival of strangers." },
    { "key": "hero.wd_ibnbattuta", "value": "Cheonrigaek" },
    { "key": "hero.wd_ibnbattuta.quote", "value": "As long as there is a road, I will not stop walking." },
    { "key": "hero.wd_hammurabi", "value": "Yulbeopseok" },
    { "key": "hero.wd_hammurabi.quote", "value": "An eye for an eye, a tooth for a tooth — carved in stone." },
    { "key": "hero.wd_attila", "value": "Jaeangpyeon" },
    { "key": "hero.wd_attila.quote", "value": "The scourge of heaven is here." },
