    { "key": "era_folk.photographer", "value": "Traveling Photographer" },
    { "key": "era_folk.photographer.0", "value": "Right in the middle of the Yellow Turban uprising? I have to get a shot. Could you step toward that chief a bit?" },
    { "key": "era_folk.photographer.1", "value": "My phone's at 12%. I guess there's nowhere to charge it in this era." },
    { "key": "era_folk.photographer.2", "value": "That guy in the helmet who just passed looks exactly like a biker from my time." },
    { "key": "era_folk.photographer.3", "value": "There's a crack in the sky in my photos. That must be the time rift." },
    { "key": "era_folk.story_chrononaut", "value": "Time Traveler" },
    { "key": "era_folk.story_chrononaut.0", "value": "My records only call this field 'the first hunting ground'. I didn't know it was this noisy." },
    { "key": "era_folk.story_chrononaut.1", "value": "The deeper the Labyrinth floor, the wider the rift. Don't push it if you meet the Steel Colossus." },
    { "key": "era_folk.story_chrononaut.2", "value": "That martial art only survives as drawings in my era's manuals." },
    { "key": "era_folk.story_chrononaut.3", "value": "My return coordinates keep drifting. I'll just watch from here for a while." },
