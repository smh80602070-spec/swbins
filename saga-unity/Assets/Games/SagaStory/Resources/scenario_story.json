        {
            "Id": "name1",
            "ChapterId": "p4_name",
            "Lines": [
                {
                    "Who": "mentor",
                    "Ko": "이름 없이 여기까지 왔구나. 마지막 자리다. 한컷의 사진 속 너는 이 땅의 사람이 아니더구나."
                },
                {
                    "Who": "mentor",
                    "Ko": "이음이 돌아갈 빛이 문 앞에서 기다린다. 서둘러 마지막 전직을 마쳐라."
                },
                {
                    "Who": "mentor",
                    "Ko": "🥋 무예창에서 4차 전직을 하여라."
                }
            ],
            "Choice": {
                "Id": "",
